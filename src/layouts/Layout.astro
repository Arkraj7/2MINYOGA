---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title || 'Quick Yoga Stress Relief | 2-Minute Bite-Sized Routines'}</title>
    <meta name="description" content={description || 'Need quick yoga stress relief? Discover 2-to-5-minute bite-sized yoga routines and quick stretches perfect for the office, school, or home. Start relaxing now.'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonical || 'https://yogainamin.com'} />
    <meta name="keywords" content="quick yoga stress relief, 2 minute yoga, 5 minute yoga flow, office desk yoga, bite-sized yoga, micro yoga sessions, nervous system reset yoga, yoga stress management" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title || 'Quick Yoga Stress Relief | 2-Minute Bite-Sized Routines'} />
    <meta property="og:description" content={description || 'Need quick yoga stress relief? Discover 2-to-5-minute bite-sized yoga routines and quick stretches perfect for the office, school, or home. Start relaxing now.'} />
    <meta property="og:url" content={canonical || 'https://yogainamin.com'} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || 'Quick Yoga Stress Relief | 2-Minute Bite-Sized Routines'} />
    <meta name="twitter:description" content={description || 'Need quick yoga stress relief? Discover 2-to-5-minute bite-sized yoga routines and quick stretches perfect for the office, school, or home.'} />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  const saved = localStorage.getItem('theme');
  if (saved === 'dark') document.documentElement.classList.add('dark');
</script>

<style is:global>
  @import "tailwindcss";

  @theme {
    --color-ink: #171717;
    --color-body: #4d4d4d;
    --color-mute: #888888;
    --color-hairline: #ebebeb;
    --color-hairline-strong: #a1a1a1;
    --color-canvas: #ffffff;
    --color-canvas-soft: #fafafa;
    --color-canvas-soft-2: #f5f5f5;
    --color-link: #0070f3;
    --color-link-deep: #0761d1;
    --color-success: #0070f3;
    --color-error: #ee0000;
    --color-warning: #f5a623;
    --color-violet: #7928ca;
    --color-cyan: #50e3c2;
    --color-highlight-pink: #ff0080;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  }

  html.dark {
    --color-ink: #ededed;
    --color-body: #a1a1a1;
    --color-mute: #6b6b6b;
    --color-hairline: #333333;
    --color-hairline-strong: #555555;
    --color-canvas: #0a0a0a;
    --color-canvas-soft: #111111;
    --color-canvas-soft-2: #1a1a1a;
    --color-link: #3291ff;
  }

  html {
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    background: var(--color-canvas-soft);
    color: var(--color-body);
  }

  ::selection {
    background: var(--color-ink);
    color: var(--color-canvas);
  }

  html.dark ::selection {
    background: var(--color-canvas);
    color: var(--color-ink);
  }
</style>
