---
import CookieConsent from '../components/CookieConsent.astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Yoga" />
    <meta name="theme-color" content="#0d9488" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title || 'Quick Yoga Stress Relief | 2-Minute Bite-Sized Routines'}</title>
    <meta name="description" content={description || 'Learn yoga online free with 2-minute quick yoga routines for beginners, kids, and adults. Discover simple yoga exercises at home, quick yoga poses, instant yoga stress relief, plus the history, philosophy, and science-backed benefits of yoga.'} />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical || 'https://yogainamin.com'} />
    <meta name="keywords" content="quick yoga workout, quick yoga routine for beginners, simple yoga exercises at home, quick yoga for kids, instant yoga, yoga meaning, yoga benefits, yoga history, yoga online for beginners, yoga philosophy, quick yoga poses, learn yoga online, learn yoga for beginners, learn yoga for adults, learn yoga at home, learn yoga online free, quick yoga stress relief, 2 minute yoga, 5 minute yoga flow, office desk yoga, bite-sized yoga, micro yoga sessions, nervous system reset yoga, yoga stress management" />
    <meta name="image_src" content="https://yogainamin.com/og-image.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yoga in a Min" />
    <meta property="og:title" content={title || 'Quick Yoga Stress Relief | 2-Minute Bite-Sized Routines'} />
    <meta property="og:description" content={description || 'Learn yoga online free with 2-minute quick yoga routines for beginners, kids, and adults. Discover simple yoga exercises at home, quick yoga poses, instant yoga stress relief, plus the history, philosophy, and science-backed benefits of yoga.'} />
    <meta property="og:url" content={canonical || 'https://yogainamin.com'} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://yogainamin.com/og-image.png" />
    <meta property="og:image:secure_url" content="https://yogainamin.com/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yoga in a Min - Quick yoga stress relief in 2 minutes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@yogainamin" />
    <meta name="twitter:title" content={title || 'Quick Yoga Stress Relief | 2-Minute Bite-Sized Routines'} />
    <meta name="twitter:description" content={description || 'Learn yoga online free with 2-minute quick yoga routines for beginners, kids, and adults. Discover simple yoga exercises at home, quick yoga poses, instant yoga stress relief.'} />
    <meta name="twitter:image" content="https://yogainamin.com/og-image.png" />
    <meta name="twitter:image:alt" content="Yoga in a Min - Quick yoga stress relief in 2 minutes" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
            document.documentElement.classList.add(saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
    <noscript>
      <style>
        .reveal-item { opacity: 1 !important; transform: none !important; }
      </style>
      <div
        role="region"
        aria-label="Cookie consent notice"
        style="position:fixed;bottom:16px;left:16px;right:16px;z-index:50;max-width:640px;margin:0 auto;padding:16px;border-radius:8px;background:var(--color-canvas);border:1px solid var(--color-hairline);box-shadow:0 10px 30px rgba(0,0,0,0.12);font-size:14px;line-height:1.5;color:var(--color-body);"
      >
        <p style="margin:0 0 8px 0;color:var(--color-ink);font-weight:600;">JavaScript is disabled</p>
        <p style="margin:0 0 12px 0;">This site uses Google Analytics cookies (only after you accept) and stores your theme preference. With JavaScript disabled, no analytics are loaded and no cookies are set. See our <a href="/privacy" style="color:var(--color-link);">privacy policy</a> for details.</p>
      </div>
    </noscript>
    <CookieConsent />
    <script>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500
      });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-77R09H0V2F"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-77R09H0V2F');
    </script>
    <script>
      const main = document.querySelector('main');
      if (main) {
        main.id = 'main-content';
        main.setAttribute('tabindex', '-1');
      }
    </script>
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @custom-variant dark (&:where(.dark, .dark *));

  @font-face {
    font-family: 'Inter Fallback';
    src: local('Arial');
    ascent-override: 90%;
    descent-override: 22.43%;
    line-gap-override: 0%;
    size-adjust: 107.4%;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/inter-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/inter-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @font-face {
    font-family: 'JetBrains Mono Fallback';
    src: local('Courier New');
    ascent-override: 102.43%;
    descent-override: 22.97%;
    line-gap-override: 0%;
    size-adjust: 105.65%;
  }

  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url('/fonts/jetbrains-mono-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  @theme {
    --color-ink: #171717;
    --color-body: #4d4d4d;
    --color-mute: #6b6b6b;
    --color-hairline: #ebebeb;
    --color-hairline-strong: #a1a1a1;
    --color-canvas: #ffffff;
    --color-canvas-soft: #fafafa;
    --color-canvas-soft-2: #f5f5f5;
    --color-link: #0070f3;
    --color-link-deep: #0761d1;
    --color-success: #0070f3;
    --color-error: #ee0000;
    --color-warning: #f5a623;
    --color-violet: #7928ca;
    --color-cyan: #50e3c2;
    --color-highlight-pink: #ff0080;
    --font-sans: 'Inter', 'Inter Fallback', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', 'JetBrains Mono Fallback', ui-monospace, monospace;
  }

  html.dark {
    --color-ink: #ededed;
    --color-body: #a1a1a1;
    --color-mute: #6b6b6b;
    --color-hairline: #333333;
    --color-hairline-strong: #555555;
    --color-canvas: #0a0a0a;
    --color-canvas-soft: #111111;
    --color-canvas-soft-2: #1a1a1a;
    --color-link: #3291ff;
  }

  html {
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Skip link: hidden until focused via keyboard */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 12px;
    z-index: 9999;
    padding: 10px 16px;
    background: var(--color-ink);
    color: var(--color-canvas);
    text-decoration: none;
    border-radius: 6px;
    font-weight: 500;
    font-size: 14px;
    transition: top 0.15s ease;
  }
  .skip-link:focus,
  .skip-link:focus-visible {
    top: 12px;
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  /* Screen-reader-only utility (visually hidden but announced) */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Global focus-visible ring for keyboard users only */
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  [role="button"]:focus-visible,
  [tabindex]:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Main element becomes focusable when targeted by skip link */
  main:focus {
    outline: none;
  }

  /* Respect users who prefer reduced motion (WCAG 2.3.3) */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    .btn-calm__bg-layer,
    .btn-3d__top,
    .btn-gradient::before,
    .btn-send::before {
      transition: none !important;
      animation: none !important;
    }
    .reveal-item {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  /* Respect users who prefer high contrast (WCAG 1.4.6) */
  @media (prefers-contrast: more) {
    :root {
      --color-mute: #4a4a4a;
      --color-hairline: #000000;
      --color-body: #1a1a1a;
    }
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    [role="button"]:focus-visible,
    [tabindex]:focus-visible {
      outline: 3px solid #000000 !important;
      outline-offset: 2px !important;
    }
  }

  /* Respect users who prefer dark color scheme (only when no manual choice) */
  @media (prefers-color-scheme: dark) {
    :root:not(.light):not(.dark):not([data-theme]) {
      --color-ink: #f5f5f5;
      --color-body: #d1d1d1;
      --color-mute: #a8a8a8;
      --color-canvas: #121212;
      --color-canvas-soft: #1a1a1a;
      --color-hairline: #2e2e2e;
      color-scheme: dark;
    }
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100vh;
    background: var(--color-canvas-soft);
    color: var(--color-body);
  }

  ::selection {
    background: var(--color-ink);
    color: var(--color-canvas);
  }

  html.dark ::selection {
    background: var(--color-canvas);
    color: var(--color-ink);
  }

  .btn-3d {
    --button_radius: 0.75em;
    --button_color: var(--color-canvas);
    --button_outline_color: var(--color-ink);
    font-size: 17px;
    font-weight: bold;
    border: none;
    cursor: pointer;
    border-radius: var(--button_radius);
    background: var(--button_outline_color);
    text-decoration: none;
    display: inline-block;
  }

  .btn-3d__top {
    display: block;
    box-sizing: border-box;
    border: 2px solid var(--button_outline_color);
    border-radius: var(--button_radius);
    padding: 0.75em 1.5em;
    background: var(--button_color);
    color: var(--button_outline_color);
    transform: translateY(-0.2em);
    transition: transform 0.1s ease;
  }

  .btn-3d:hover .btn-3d__top {
    transform: translateY(-0.33em);
  }

  .btn-3d:active .btn-3d__top {
    transform: translateY(0);
  }

  .btn-gradient {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 13rem;
    overflow: hidden;
    height: 3rem;
    background-size: 300% 300%;
    cursor: pointer;
    backdrop-filter: blur(1rem);
    border-radius: 5rem;
    transition: 0.5s;
    animation: gradient_301 5s ease infinite;
    border: double 4px transparent;
    background-image: linear-gradient(#212121, #212121),
      linear-gradient(
        137.48deg,
        #ffdb3b 10%,
        #fe53bb 45%,
        #8f51ea 67%,
        #0044ff 87%
      );
    background-origin: border-box;
    background-clip: content-box, border-box;
    text-decoration: none;
    position: relative;
  }

  .btn-gradient__stars {
    position: absolute;
    z-index: -1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    transition: 0.5s;
    backdrop-filter: blur(1rem);
    border-radius: 5rem;
  }

  .btn-gradient__stars-inner {
    position: relative;
    background: transparent;
    width: 200rem;
    height: 200rem;
  }

  .btn-gradient__stars-inner::after {
    content: "";
    position: absolute;
    top: -10rem;
    left: -100rem;
    width: 100%;
    height: 100%;
    animation: animStarRotate 90s linear infinite;
    background-image: radial-gradient(#ffffff 1px, transparent 1%);
    background-size: 50px 50px;
  }

  .btn-gradient__stars-inner::before {
    content: "";
    position: absolute;
    top: 0;
    left: -50%;
    width: 170%;
    height: 500%;
    animation: animStar 60s linear infinite;
    background-image: radial-gradient(#ffffff 1px, transparent 1%);
    background-size: 50px 50px;
    opacity: 0.5;
  }

  .btn-gradient__label {
    z-index: 2;
    font-family: "Avalors Personal Use", "Inter", system-ui, -apple-system, sans-serif;
    font-size: 12px;
    letter-spacing: 5px;
    color: #ffffff;
    text-shadow: 0 0 4px white;
    text-transform: uppercase;
  }

  .btn-gradient__glow {
    position: absolute;
    display: flex;
    width: 12rem;
  }

  .btn-gradient__circle {
    width: 100%;
    height: 30px;
    filter: blur(2rem);
    animation: pulse_3011 4s infinite;
    z-index: -1;
  }

  .btn-gradient__circle:nth-of-type(1) {
    background: rgba(254, 83, 186, 0.636);
  }

  .btn-gradient__circle:nth-of-type(2) {
    background: rgba(142, 81, 234, 0.704);
  }

  .btn-gradient:hover .btn-gradient__stars {
    z-index: 1;
    background-color: #212121;
  }

  .btn-gradient:hover {
    transform: scale(1.1);
  }

  .btn-gradient:active {
    border: double 4px #fe53bb;
    background-origin: border-box;
    background-clip: content-box, border-box;
    animation: none;
  }

  .btn-gradient:active .btn-gradient__circle {
    background: #fe53bb;
  }

  @keyframes animStar {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-135rem);
    }
  }

  @keyframes animStarRotate {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0);
    }
  }

  @keyframes gradient_301 {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @keyframes pulse_3011 {
    0% {
      transform: scale(0.75);
      box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 10px rgba(0, 0, 0, 0);
    }
    100% {
      transform: scale(0.75);
      box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-gradient,
    .btn-gradient__stars-inner::after,
    .btn-gradient__stars-inner::before,
    .btn-gradient__circle {
      animation: none !important;
    }
  }

  .btn-gradient.is-offscreen,
  .btn-gradient.is-offscreen .btn-gradient__stars-inner::after,
  .btn-gradient.is-offscreen .btn-gradient__stars-inner::before,
  .btn-gradient.is-offscreen .btn-gradient__circle {
    animation-play-state: paused;
  }

  .btn-calm {
    all: unset;
    position: relative;
    display: none;
    height: 2.5rem;
    align-items: center;
    border-radius: 9999px;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    font-size: 0.95rem;
    font-weight: 640;
    color: #fafaf6;
    letter-spacing: -0.06em;
    cursor: pointer;
    text-decoration: none;
    box-sizing: border-box;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .btn-calm {
      display: inline-flex;
    }
  }

  .btn-calm--item {
    background-color: transparent;
    color: #1d1d1f;
  }

  .btn-calm--item .btn-calm__bg {
    border-color: rgba(255, 208, 116);
    background-color: rgba(255, 208, 116);
  }

  .btn-calm__inner,
  .btn-calm__inner-hover,
  .btn-calm__inner-static {
    pointer-events: none;
    display: block;
    line-height: 1;
  }

  .btn-calm__inner {
    position: relative;
    overflow: hidden;
    height: 100%;
  }

  .btn-calm__inner-static {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    transform: translateY(0);
    opacity: 1;
  }

  .btn-calm__inner-hover {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(70%);
  }

  .btn-calm__bg {
    overflow: hidden;
    border-radius: 2rem;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: scale(1);
    transition: transform 1.8s cubic-bezier(0.19, 1, 0.22, 1);
    border: 2px solid;
  }

  .btn-calm__bg,
  .btn-calm__bg-layer,
  .btn-calm__bg-layers {
    display: block;
  }

  .btn-calm__bg-layers {
    position: absolute;
    left: 50%;
    transform: translate(-50%);
    top: -60%;
    aspect-ratio: 1 / 1;
    width: max(200%, 10rem);
  }

  .btn-calm__bg-layer {
    border-radius: 9999px;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: scale(0);
  }

  .btn-calm__bg-layer--purple {
    background-color: rgba(163, 116, 255);
  }

  .btn-calm__bg-layer--turquoise {
    background-color: rgba(23, 241, 209);
  }

  .btn-calm__bg-layer--yellow {
    --tw-bg-opacity: 1;
    background-color: rgba(255, 208, 116, var(--tw-bg-opacity));
  }

  .btn-calm:hover .btn-calm__inner-static {
    opacity: 0;
    transform: translateY(-70%);
    transition:
      transform 1.4s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.3s linear;
  }

  .btn-calm:hover .btn-calm__inner-hover {
    opacity: 1;
    transform: translateY(0);
    transition:
      transform 1.4s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 1.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .btn-calm:hover .btn-calm__bg-layer {
    transition:
      transform 1.3s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.3s linear;
  }

  .btn-calm:hover .btn-calm__bg-layer-1 {
    transform: scale(1);
  }

  .btn-calm:hover .btn-calm__bg-layer-2 {
    transition-delay: 0.1s;
    transform: scale(1);
  }

  .btn-calm:hover .btn-calm__bg-layer-3 {
    transition-delay: 0.2s;
    transform: scale(1);
  }

  @media (max-width: 640px) {
    #mobile-menu .btn-calm {
      height: 2rem;
      padding-left: 1rem;
      padding-right: 1rem;
      font-size: 0.85rem;
      align-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-calm__bg,
    .btn-calm__bg-layer,
    .btn-calm__inner-static,
    .btn-calm__inner-hover {
      transition: none;
    }
  }

  .btn-send {
    position: relative;
