---
export interface Step {
  title: string;
  instructions: string;
}

export interface Props {
  steps: Step[];
  moduleTitle: string;
}

const { steps, moduleTitle } = Astro.props;
---

<div
  id="voiceover-root"
  data-props={JSON.stringify({ steps, moduleTitle })}
  class="overflow-hidden rounded-lg border"
  style="border-color: var(--color-hairline); background: var(--color-canvas);"
>
  <div class="p-4">
    <div class="flex items-center gap-2">
      <button id="vo-play" class="flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium text-white transition-all hover:opacity-90" style="background: var(--color-ink);" aria-label="Start guided voice over">
        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"/></svg>
        Listen
      </button>
      <button id="vo-pause" class="hidden flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition-all hover:opacity-60" style="border-color: var(--color-hairline); color: var(--color-body); background: var(--color-canvas);" aria-label="Pause voice over">
        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.75 5.25a.75.75 0 01.75-.75H9a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H7.5a.75.75 0 01-.75-.75V5.25zm7.5 0A.75.75 0 0115 4.5h1.5a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H15a.75.75 0 01-.75-.75V5.25z"/></svg>
        Pause
      </button>
      <button id="vo-stop" class="hidden flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition-all hover:opacity-60" style="border-color: var(--color-hairline); color: var(--color-body); background: var(--color-canvas);" aria-label="Stop voice over">
        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5.25 7.5A2.25 2.25 0 017.5 5.25h9a2.25 2.25 0 012.25 2.25v9a2.25 2.25 0 01-2.25 2.25h-9a2.25 2.25 0 01-2.25-2.25v-9z"/></svg>
        Stop
      </button>
      <span id="vo-status" class="ml-2 text-[10px]" style="color: var(--color-mute);" aria-live="polite" aria-atomic="true">Ready</span>
      <div class="ml-auto flex items-center gap-1.5">
        <span class="text-[10px]" style="color: var(--color-mute);">Vol</span>
        <input type="range" id="vo-volume" min="0" max="1" step="0.05" value="0.8" class="h-1 w-12 cursor-pointer appearance-none rounded-full" style="background: var(--color-hairline); accent-color: var(--color-ink);" aria-label="Volume">
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('voiceover-root');
    if (!root) return;

    const props = JSON.parse(root.dataset.props || '{}');
    const steps = props.steps || [];
    if (!steps.length) return;

    const playBtn = document.getElementById('vo-play');
    const pauseBtn = document.getElementById('vo-pause');
    const stopBtn = document.getElementById('vo-stop');
    const volumeInput = document.getElementById('vo-volume');
    const statusEl = document.getElementById('vo-status');

    let utterance = null;
    let isPaused = false;
    let selectedVoiceUri = '';
    let voices = [];
    let currentStepIndex = -1;
    let totalSteps = steps.length;
    let sessionId = 0;
    let listenMode = false;

    function populateVoices() {
      voices = window.speechSynthesis.getVoices();
      selectedVoiceUri = '';
    }

    function scoreVoice(voice) {
      const name = voice.name.toLowerCase();
      let score = 0;
      if (name.includes('male')) score += 10;
      if (name.includes('deep')) score += 8;
      if (name.includes('natural')) score += 4;
      if (name.includes('premium')) score += 3;
      if (name.includes('microsoft')) score += 2;
      if (name.includes('google')) score += 1;
      return score;
    }

    function pickDeepVoice() {
      const english = voices.filter((v) => v.lang.startsWith('en'));
      if (english.length === 0) return null;
      english.sort((a, b) => scoreVoice(b) - scoreVoice(a));
      return english[0];
    }

    const encouragements = [
      'Well done', 'Good job', 'Great work', 'Fantastic',
      'Awesome', 'Beautiful', 'Excellent', 'Wonderful',
      'Perfect', 'Nice work', 'Keep it up', 'Lovely',
    ];

    function buildVoice(u) {
      u.rate = 0.7;
      u.pitch = 0.85;
      u.volume = parseFloat(volumeInput.value);
      if (selectedVoiceUri) {
        const match = voices.find((v) => v.voiceURI === selectedVoiceUri);
        if (match) u.voice = match;
      } else {
        const deep = pickDeepVoice();
        if (deep) u.voice = deep;
      }
    }

    function speakStep(stepIdx) {
      const step = steps[stepIdx];
      if (!step) return;

      const text = step.title + '. ' + step.instructions;

      utterance = new SpeechSynthesisUtterance(text);
      buildVoice(utterance);

      const currentSession = sessionId;

      utterance.onstart = () => {
        if (currentSession !== sessionId) return;
        statusEl.textContent = `Reading step ${stepIdx + 1} of ${totalSteps}`;
      };

      utterance.onend = () => {
        if (currentSession !== sessionId) return;
      };

      utterance.onpause = () => {
        if (currentSession !== sessionId) return;
        isPaused = true;
        statusEl.textContent = 'Paused';
      };

      utterance.onresume = () => {
        if (currentSession !== sessionId) return;
        isPaused = false;
        statusEl.textContent = `Reading step ${stepIdx + 1} of ${totalSteps}`;
      };

      utterance.onerror = (e) => {
        if (e.error === 'canceled' || e.error === 'interrupted') return;
        statusEl.textContent = 'Error';
      };

      window.speechSynthesis.speak(utterance);
    }

    function speakTransition(stepIdx) {
      const step = steps[stepIdx];
      if (!step) return;

      const encouragement = encouragements[Math.floor(Math.random() * encouragements.length)];
      const message = encouragement + '. Now let\'s move to ' + step.title + '.';

      utterance = new SpeechSynthesisUtterance(message);
      buildVoice(utterance);

      const currentSession = sessionId;

      utterance.onstart = () => {
        if (currentSession !== sessionId) return;
        statusEl.textContent = `Reading step ${stepIdx + 1} of ${totalSteps}`;
      };

      utterance.onend = () => {
        if (currentSession !== sessionId) return;
        speakStep(stepIdx);
      };

      utterance.onpause = () => {
        if (currentSession !== sessionId) return;
        isPaused = true;
        statusEl.textContent = 'Paused';
      };

      utterance.onresume = () => {
        if (currentSession !== sessionId) return;
        isPaused = false;
        statusEl.textContent = `Reading step ${stepIdx + 1} of ${totalSteps}`;
      };

      utterance.onerror = (e) => {
        if (e.error === 'canceled' || e.error === 'interrupted') return;
        statusEl.textContent = 'Error';
      };

      window.speechSynthesis.speak(utterance);
    }

    function cancelTTS() {
      window.speechSynthesis.cancel();
      isPaused = false;
      utterance = null;
    }

    function showActiveButtons() {
      playBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');
      stopBtn.classList.remove('hidden');
    }

    function showIdleButtons() {
      playBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
      stopBtn.classList.add('hidden');
    }

    document.addEventListener('timer:started', (e) => {
      if (!listenMode) return;
      sessionId++;
      cancelTTS();
      currentStepIndex = -1;
      totalSteps = e.detail.totalSteps || steps.length;
      showActiveButtons();
      statusEl.textContent = 'Starting...';
    });

    document.addEventListener('timer:resumed', () => {
      if (!listenMode) return;
      if (utterance && isPaused) {
        window.speechSynthesis.resume();
      }
    });

    document.addEventListener('timer:step-change', (e) => {
      if (!listenMode) return;
      const stepIdx = e.detail.index;
      if (stepIdx === currentStepIndex) return;
      sessionId++;
      cancelTTS();
      currentStepIndex = stepIdx;
      if (stepIdx === 0) {
        speakStep(stepIdx);
      } else {
        speakTransition(stepIdx);
      }
    });

    document.addEventListener('timer:paused', () => {
      if (utterance && !isPaused) {
        window.speechSynthesis.pause();
      }
    });

    document.addEventListener('timer:stopped', () => {
      listenMode = false;
      sessionId++;
      cancelTTS();
      currentStepIndex = -1;
      showIdleButtons();
      statusEl.textContent = 'Stopped';
    });

    document.addEventListener('timer:complete', () => {
      listenMode = false;
      sessionId++;
      cancelTTS();
      currentStepIndex = -1;
      showIdleButtons();
      statusEl.textContent = 'Complete';
    });

    playBtn.addEventListener('click', () => {
      const timerRoot = document.getElementById('timer-root');
      if (!timerRoot) return;
      listenMode = true;
      timerRoot.dispatchEvent(new CustomEvent('vo:play'));
    });

    pauseBtn.addEventListener('click', () => {
      if (window.speechSynthesis.speaking && !isPaused) {
        window.speechSynthesis.pause();
      }
      const timerRoot = document.getElementById('timer-root');
      if (timerRoot) {
        timerRoot.dispatchEvent(new CustomEvent('vo:pause'));
      }
    });

    stopBtn.addEventListener('click', () => {
      listenMode = false;
      const timerRoot = document.getElementById('timer-root');
      if (timerRoot) {
        timerRoot.dispatchEvent(new CustomEvent('vo:stop'));
      }
    });

    volumeInput.addEventListener('input', () => {
      if (utterance) utterance.volume = parseFloat(volumeInput.value);
    });

    if (window.speechSynthesis.getVoices().length > 0) populateVoices();
    window.speechSynthesis.onvoiceschanged = populateVoices;
  })();
</script>
