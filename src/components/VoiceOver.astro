---
export interface Props {
  script: string;
  moduleTitle: string;
}

const { script, moduleTitle } = Astro.props;
---

<div
  id="voiceover-root"
  data-props={JSON.stringify({ script, moduleTitle })}
  class="overflow-hidden rounded-lg border"
  style="border-color: var(--color-hairline); background: var(--color-canvas);"
>
  <div class="p-5">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--color-ink);">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z" />
        </svg>
        <span class="text-xs font-medium uppercase tracking-wider" style="color: var(--color-mute); font-family: var(--font-mono);">Guided Audio</span>
      </div>
      <select id="vo-voice-select" class="cursor-pointer rounded-md border px-2 py-1 text-xs font-medium" style="border-color: var(--color-hairline); color: var(--color-body); background: var(--color-canvas); font-family: var(--font-mono);" aria-label="Select voice">
        <option value="">Auto (deep calm voice)</option>
      </select>
    </div>

    <div class="flex items-center gap-2">
      <button id="vo-play" class="flex cursor-pointer items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-medium text-white transition-all hover:opacity-90" style="background: var(--color-ink);">
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z"/></svg>
        Play
      </button>
      <button id="vo-pause" class="hidden flex cursor-pointer items-center gap-1.5 rounded-full border px-4 py-1.5 text-sm font-medium transition-all hover:opacity-60" style="border-color: var(--color-hairline); color: var(--color-body); background: var(--color-canvas);">
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M6.75 5.25a.75.75 0 01.75-.75H9a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H7.5a.75.75 0 01-.75-.75V5.25zm7.5 0A.75.75 0 0115 4.5h1.5a.75.75 0 01.75.75v13.5a.75.75 0 01-.75.75H15a.75.75 0 01-.75-.75V5.25z"/></svg>
        Pause
      </button>
      <button id="vo-stop" class="flex cursor-pointer items-center gap-1.5 rounded-full border px-4 py-1.5 text-sm font-medium transition-all hover:opacity-60" style="border-color: var(--color-hairline); color: var(--color-body); background: var(--color-canvas);">
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M5.25 7.5A2.25 2.25 0 017.5 5.25h9a2.25 2.25 0 012.25 2.25v9a2.25 2.25 0 01-2.25 2.25h-9a2.25 2.25 0 01-2.25-2.25v-9z"/></svg>
        Stop
      </button>
      <button id="vo-loop" class="flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm font-medium transition-all" style="border-color: var(--color-hairline); color: var(--color-mute); background: var(--color-canvas);" title="Loop">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/></svg>
      </button>
      <div class="ml-auto flex items-center gap-2">
        <span class="text-xs" style="color: var(--color-mute); font-family: var(--font-mono);">Vol</span>
        <input
          type="range"
          id="vo-volume"
          min="0"
          max="1"
          step="0.05"
          value="0.8"
          class="h-1 w-16 cursor-pointer appearance-none rounded-full"
          style="background: var(--color-hairline); accent-color: var(--color-ink);"
          aria-label="Volume"
        />
      </div>
    </div>

    <div class="mt-3">
      <div class="h-1 rounded-full" style="background: var(--color-hairline);">
        <div id="vo-progress-bar" class="h-full w-0 rounded-full transition-all duration-300" style="background: var(--color-ink);"></div>
      </div>
    </div>

    <div class="mt-2 flex items-center justify-between">
      <span id="vo-status" class="text-xs" style="color: var(--color-mute); font-family: var(--font-mono);">Ready</span>
      <span id="vo-time" class="text-xs" style="color: var(--color-mute); font-family: var(--font-mono);">0:00</span>
    </div>

    <p class="mt-3 text-xs italic leading-relaxed" style="color: var(--color-body); display: none;">&ldquo;{script}&rdquo;</p>
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('voiceover-root');
    if (!root) return;

    const scriptText = JSON.parse(root.dataset.props || '{}').script || '';
    if (!scriptText) return;

    const playBtn = document.getElementById('vo-play');
    const pauseBtn = document.getElementById('vo-pause');
    const stopBtn = document.getElementById('vo-stop');
    const loopBtn = document.getElementById('vo-loop');
    const volumeInput = document.getElementById('vo-volume');
    const voiceSelect = document.getElementById('vo-voice-select');
    const progressBar = document.getElementById('vo-progress-bar');
    const statusEl = document.getElementById('vo-status');
    const timeEl = document.getElementById('vo-time');

    let utterance = null;
    let isPaused = false;
    let isLooping = false;
    let selectedVoiceUri = '';
    let voices = [];

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    }

    function populateVoices() {
      voices = window.speechSynthesis.getVoices();
      const english = voices.filter((v) => v.lang.startsWith('en'));

      voiceSelect.innerHTML = '<option value="">Auto (deep calm voice)</option>';
      english.forEach((v) => {
        const opt = document.createElement('option');
        opt.value = v.voiceURI;
        opt.textContent = `${v.name} (${v.lang})`;
        voiceSelect.appendChild(opt);
      });

      selectedVoiceUri = voiceSelect.value;
    }

    function scoreVoice(voice) {
      const name = voice.name.toLowerCase();
      let score = 0;
      if (name.includes('male')) score += 10;
      if (name.includes('deep')) score += 8;
      if (name.includes('natural')) score += 4;
      if (name.includes('premium')) score += 3;
      if (name.includes('microsoft')) score += 2;
      if (name.includes('google')) score += 1;
      return score;
    }

    function pickDeepVoice() {
      const english = voices.filter((v) => v.lang.startsWith('en'));
      if (english.length === 0) return null;
      english.sort((a, b) => scoreVoice(b) - scoreVoice(a));
      return english[0];
    }

    function speak() {
      if (window.speechSynthesis.speaking && !isPaused) {
        window.speechSynthesis.cancel();
      }

      utterance = new SpeechSynthesisUtterance(scriptText);

      utterance.rate = 0.85;
      utterance.pitch = 0.9;
      utterance.volume = parseFloat(volumeInput.value);

      if (selectedVoiceUri) {
        const match = voices.find((v) => v.voiceURI === selectedVoiceUri);
        if (match) utterance.voice = match;
      } else {
        const deep = pickDeepVoice();
        if (deep) utterance.voice = deep;
      }

      utterance.onstart = () => {
        isPaused = false;
        playBtn.classList.add('hidden');
        pauseBtn.classList.remove('hidden');
        statusEl.textContent = 'Speaking...';
        document.getElementById('timer-root')?.dispatchEvent(new CustomEvent('vo:play'));
      };

      utterance.onend = () => {
        playBtn.classList.remove('hidden');
        pauseBtn.classList.add('hidden');
        statusEl.textContent = 'Done';
        progressBar.style.width = '100%';
        timeEl.textContent = formatTime(utterance ? estimateDuration() : 0);

        if (isLooping) {
          setTimeout(() => speak(), 800);
        }
      };

      utterance.onpause = () => {
        isPaused = true;
        statusEl.textContent = 'Paused';
      };

      utterance.onresume = () => {
        isPaused = false;
        statusEl.textContent = 'Speaking...';
      };

      utterance.onerror = (e) => {
        if (e.error !== 'canceled' && e.error !== 'interrupted') {
          statusEl.textContent = 'Error';
          playBtn.classList.remove('hidden');
          pauseBtn.classList.add('hidden');
        }
      };

      utterance.onboundary = (e) => {
        if (e.name === 'word' || e.name === 'sentence') {
          const elapsed = e.elapsedTime;
          const total = estimateDuration();
          const pct = total > 0 ? Math.min((elapsed / total) * 100, 99) : 0;
          progressBar.style.width = pct + '%';
          timeEl.textContent = formatTime(elapsed);
        }
      };

      window.speechSynthesis.speak(utterance);
    }

    function estimateDuration() {
      const wpm = 150;
      const words = scriptText.split(/\s+/).length;
      return (words / wpm) * 60;
    }

    playBtn.addEventListener('click', () => {
      if (isPaused && window.speechSynthesis.speaking) {
        window.speechSynthesis.resume();
        return;
      }
      if (window.speechSynthesis.speaking) {
        window.speechSynthesis.cancel();
      }
      progressBar.style.width = '0%';
      speak();
    });

    pauseBtn.addEventListener('click', () => {
      if (window.speechSynthesis.speaking && !isPaused) {
        window.speechSynthesis.pause();
        document.getElementById('timer-root')?.dispatchEvent(new CustomEvent('vo:pause'));
      }
    });

    stopBtn.addEventListener('click', () => {
      window.speechSynthesis.cancel();
      isPaused = false;
      playBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
      statusEl.textContent = 'Stopped';
      progressBar.style.width = '0%';
      timeEl.textContent = '0:00';
      utterance = null;
      document.getElementById('timer-root')?.dispatchEvent(new CustomEvent('vo:stop'));
    });

    loopBtn.addEventListener('click', () => {
      isLooping = !isLooping;
      loopBtn.style.color = isLooping ? 'var(--color-link)' : 'var(--color-mute)';
      loopBtn.style.borderColor = isLooping ? 'var(--color-link)' : 'var(--color-hairline)';
    });

    volumeInput.addEventListener('input', () => {
      if (utterance) utterance.volume = parseFloat(volumeInput.value);
    });

    voiceSelect.addEventListener('change', () => {
      selectedVoiceUri = voiceSelect.value;
    });

    if (window.speechSynthesis.getVoices().length > 0) {
      populateVoices();
    }
    window.speechSynthesis.onvoiceschanged = populateVoices;
  })();
</script>
